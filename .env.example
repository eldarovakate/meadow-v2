SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3

# Уведомления о новых заказах
ORDER_NOTIFICATION_EMAIL=info@meadowshore.ru
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ЮKassa (Настройки -> Интеграция -> Ключи API в личном кабинете)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=

# Режим продаж: preorder (сбор предзаказов, оплата не запрашивается) или sales (обычная оплата через ЮKassa)
SALES_MODE=preorder
SALES_OPEN_DATE=2026-10-01
